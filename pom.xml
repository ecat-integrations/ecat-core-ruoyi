<?xml version='1.0' encoding='utf-8'?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ecat</groupId>
    <artifactId>ecat-project</artifactId>
    <version>4.0.0</version>
    <relativePath />
  </parent>
  <artifactId>integration-ecat-core-ruoyi</artifactId>
  <version>4.0.0</version>
  <name>integration-ecat-core-ruoyi</name>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-loader</artifactId>
      <version>2.5.15</version>
    </dependency>
    <dependency>
      <groupId>com.ecat</groupId>
      <artifactId>ecat-core</artifactId>
      <version>4.0.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.ecat</groupId>
      <artifactId>integration-ecat-db-migration</artifactId>
      <version>4.0.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-inline</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- PG JDBC 驱动:HostAgentMigrationPgIT 真库 IT 门控激活(-Decat.e2e=true + PG 环境变量齐
         才执行,默认恒跳过);test scope 不进 fatjar lib/,运行时驱动由 ruoyi 平台侧供给 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.2.27</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <descriptors>
            <descriptor>src/main/assembly/fatjar.xml</descriptor>
          </descriptors>
          <appendAssemblyId>false</appendAssemblyId>
          <archiverConfig>
            <compress>false</compress>
          </archiverConfig>
          <!-- archive 块与 archiverConfig 双写 compress=false:Stored 是嵌读的功能性硬前提
               (loader 嵌套 JarFile 靠随机访问读外层文件内偏移,Deflated 嵌套条目不可随机访问);
               两通道取值恒 false,无论哪个后执行都不翻转。Implementation-Version=运行期
               readBridgeVersion 的版本唯一材料。 -->
          <archive>
            <compress>false</compress>
            <manifestEntries>
              <Implementation-Version>${project.version}</Implementation-Version>
            </manifestEntries>
          </archive>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- 构建期嵌入取件:按自身版本从公仓取 ruoyi-admin 单件进 target/payload(assembly
           fileSet 进包内 /payload)。显式 artifactItems 枚举单件,禁用依赖树式取件——
           admin 是 spring-boot fat jar,BOOT-INF/lib 自带全部依赖,树式解析=双倍包陷阱;
           桥接 pom 禁止出现 ruoyi-admin 的 <dependency> 条目(运行载荷非编译依赖)。
           公仓无同版本 admin=Maven 解析红构建失败(发车序:ruoyi 族先发、桥接后发)。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>copy-embedded-payload</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.ecat</groupId>
                  <artifactId>ruoyi-admin</artifactId>
                  <version>${project.version}</version>
                  <type>jar</type>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/payload</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
      <comments>This integration is part of ECAT Project and licensed under Apache 2.0</comments>
    </license>
  </licenses>
</project>
